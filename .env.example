# Copy to .env and fill in. See docs/admin-setup.md.

# Public address of this service (used for the Google redirect URI and links).
PUBLIC_URL=https://calendar.example.com

# Google Cloud OAuth client (Web application).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# The Zulip "Calendar" generic bot.
ZULIP_SITE=https://chat.example.com
ZULIP_BOT_EMAIL=calendar-bot@chat.example.com
ZULIP_BOT_API_KEY=your-bot-api-key

# 32+ random bytes, base64. Generate with: openssl rand -base64 32
APP_SECRET=replace-with-32-random-bytes-base64

# Optional: comma-separated Google Workspace domains allowed to sign in.
ALLOWED_DOMAINS=example.com

# Optional (defaults shown).
DATA_DIR=/data
DEFAULT_LEAD_MINUTES=10
POLL_INTERVAL=3m

# Only used by the commented Traefik labels in docker-compose.yml.
TRAEFIK_HOST=calendar.example.com
